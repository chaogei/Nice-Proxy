{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "detour": "proxy"
      },
      {
        "type": "udp",
        "tag": "dns-local",
        "server": "223.5.5.5"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-local"
      }
    ],
    "final": "dns-remote",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "in-mix",
      "listen": "0.0.0.0",
      "listen_port": 8080,
      "users": [
        {
          "username": "alice",
          "password": "s3cret"
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "auto",
        "node-h2",
        "node-vl",
        "direct"
      ],
      "default": "auto"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "node-h2",
        "node-vl"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      "type": "hysteria2",
      "tag": "node-h2",
      "server": "hy2.example.com",
      "server_port": 443,
      "password": "pw",
      "up_mbps": 100,
      "down_mbps": 300,
      "obfs": {
        "type": "salamander",
        "password": "ob"
      },
      "tls": {
        "enabled": true,
        "server_name": "hy2.example.com",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "vless",
      "tag": "node-vl",
      "server": "1.2.3.4",
      "server_port": 443,
      "uuid": "11111111-2222-3333-4444-555555555555",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "www.microsoft.com",
        "reality": {
          "enabled": true,
          "public_key": "jNXHt1yRo0vDuchQlIP6Z0ZvjT3KtzVI-T4E7RoLJS0",
          "short_id": "ab12"
        },
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff",
        "timeout": "300ms"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "outbound": "direct"
      },
      {
        "action": "resolve",
        "strategy": "prefer_ipv4"
      },
      {
        "rule_set": [
          "geoip-cn"
        ],
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://example.com/geosite-cn.srs",
        "download_detour": "proxy",
        "update_interval": "7d"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://example.com/geoip-cn.srs",
        "download_detour": "proxy",
        "update_interval": "7d"
      }
    ],
    "final": "proxy",
    "auto_detect_interface": false,
    "default_domain_resolver": "dns-local"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:19090",
      "secret": "test-secret"
    },
    "cache_file": {
      "enabled": true,
      "path": "/data/user/0/com.niceproxy/files/cache.db",
      "store_rdrc": true
    }
  }
}